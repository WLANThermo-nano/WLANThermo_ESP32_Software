{
  "name": "WLANThermo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve --mode development",
    "build": "npm run build-nano && npm run build-link && npm run build-cloud && npm run build-mini && npm run build-demo && npm run build-mobile",
    "lint": "vue-cli-service lint",
    "build-cloud": "vue-cli-service build --mode cloud",
    "build-demo": "vue-cli-service build --mode demo",
    "build-link": "vue-cli-service build --mode link",
    "build-mini": "vue-cli-service build --mode mini",
    "build-nano": "vue-cli-service build --mode nano",
    "build-bone": "vue-cli-service build --mode bone",
    "build-mobile": "vue-cli-service build --mode mobile && node copyMobileBuildResults.js"
  },
  "dependencies": {
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.7.9",
    "core-js": "^3.38.0",
    "mitt": "^3.0.1",
    "netmask": "^1.0.6",
    "vue": "^3.4.0",
    "vue-axios": "^3.5.2",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.24.0",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-eslint": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "compression-webpack-plugin": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "@effortlessmotion/html-webpack-inline-source-plugin": "^1.0.3",
    "sass": "^1.77.0",
    "sass-loader": "^14.2.0",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {
      "vue/multi-word-component-names": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
